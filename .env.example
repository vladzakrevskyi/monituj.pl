DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# Production only (config.settings.prod), e.g. https://monituj.pl
CSRF_TRUSTED_ORIGINS=

# Host-side default (running manage.py directly against `docker compose up db redis`).
# The web/worker/beat containers override these to db/redis service hostnames automatically.
DATABASE_URL=postgres://monituj:monituj@localhost:5432/monituj
POSTGRES_DB=monituj
POSTGRES_USER=monituj
POSTGRES_PASSWORD=monituj

REDIS_URL=redis://localhost:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Monituj <no-reply@monituj.pl>
# Contact form messages go here; replies to system emails land here too.
CONTACT_EMAIL=kontakt@monituj.pl

# Operator details for /regulamin/, /polityka-prywatnosci/, /polityka-cookies/,
# /umowa-powierzenia/. Empty values show as "[uzupelnij ...]" placeholders.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_NIP=
LEGAL_REGON=
# e.g. "KRS 0000000000, Sad Rejonowy ..." or "CEIDG"
LEGAL_REGISTER=
LEGAL_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOSTING_PROVIDER=
LEGAL_EMAIL_PROVIDER=
# Country where servers are located, e.g. Polska (EOG)
LEGAL_HOSTING_LOCATION=
# e.g. 1 pazdziernika 2026
LEGAL_EFFECTIVE_DATE=
# How many days backups are kept before being overwritten
LEGAL_BACKUP_DAYS=

# Maintenance mode: True shows everyone a "prace techniczne" page (HTTP 503).
# Listed addresses see the site normally - comma separated, ranges allowed:
# MAINTENANCE_ALLOWED_IPS=83.12.34.56,2a01:4f8::1,10.0.0.0/24
MAINTENANCE_MODE=False
MAINTENANCE_ALLOWED_IPS=

# --- Analytics & SEO -------------------------------------------------------
# Sign in with Google: OAuth client ("Web application") from Google Cloud
# Console, redirect URI <SITE_URL>/logowanie/google/powrot/ (see README).
# Both empty = no Google buttons.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Tag Manager container. Loads only on public pages and only after the
# visitor accepts cookies in the banner. Empty = no analytics at all.
GTM_ID=
# Tools you run inside GTM (comma separated): ga4, google_ads, meta_pixel,
# clarity, linkedin. They fill the cookie banner, the cookie and privacy
# policies and the CSP. A new kind of tool: add it to apps/common/cookies.py.
TRACKING_SERVICES=ga4
# Ownership tokens from Google Search Console / Bing Webmaster Tools
# ("HTML tag" method: paste only the content="..." value). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
