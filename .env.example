DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# Production only (config.settings.prod), e.g. https://monituj.pl
CSRF_TRUSTED_ORIGINS=

# Host-side default (running manage.py directly against `docker compose up db redis`).
# The web/worker/beat containers override these to db/redis service hostnames automatically.
DATABASE_URL=postgres://monituj:monituj@localhost:5432/monituj
POSTGRES_DB=monituj
POSTGRES_USER=monituj
POSTGRES_PASSWORD=monituj

REDIS_URL=redis://localhost:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Monituj <no-reply@monituj.pl>
# Contact form messages go here; replies to system emails land here too.
CONTACT_EMAIL=kontakt@monituj.pl

# Operator details for /regulamin/, /polityka-prywatnosci/, /polityka-cookies/,
# /umowa-powierzenia/. Empty values show as "[uzupelnij ...]" placeholders.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_NIP=
LEGAL_REGON=
# e.g. "KRS 0000000000, Sad Rejonowy ..." or "CEIDG"
LEGAL_REGISTER=
LEGAL_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOSTING_PROVIDER=
# Company names (not email addresses), e.g. "cyber_Folks S.A."
LEGAL_EMAIL_PROVIDER=
# CDN / proxy in front of the site, e.g. "Cloudflare, Inc." - empty if none.
LEGAL_CDN_PROVIDER=
# Country where servers are located, e.g. Polska (EOG)
LEGAL_HOSTING_LOCATION=
# Effective date of the Terms / Privacy policy / DPA - also their version:
# 2026-10-01 or 01.10.2026. Changing it asks every user to accept the new
# version (from that day) - see README "Zmiana dokumentów prawnych".
LEGAL_EFFECTIVE_DATE=
# How many days backups are kept before being overwritten
LEGAL_BACKUP_DAYS=

# Maintenance mode: True shows everyone a "prace techniczne" page (HTTP 503).
# Listed addresses see the site normally - comma separated, ranges allowed:
# MAINTENANCE_ALLOWED_IPS=83.12.34.56,2a01:4f8::1,10.0.0.0/24
MAINTENANCE_MODE=False
MAINTENANCE_ALLOWED_IPS=

# --- Analytics & SEO -------------------------------------------------------
# Django admin: its address (hard to guess, e.g. zaplecze-7f3k2/) and the
# addresses allowed to open it (comma separated, ranges like 10.0.0.0/24).
# Empty ADMIN_ALLOWED_IPS = no limit - set it on the server.
ADMIN_URL=admin/

ADMIN_ALLOWED_IPS=
# Master key encrypting uploaded documents on disk (AES-256-GCM). Required
# in production. Generate:
#   python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# KEEP A COPY OUTSIDE THE SERVER (password manager): lose it = lose the files.
DOCUMENTS_ENCRYPTION_KEY=
# Old master keys while rotating (comma separated), see README.
DOCUMENTS_ENCRYPTION_OLD_KEYS=
# Sign in with Google: OAuth client ("Web application") from Google Cloud
# Console, redirect URI <SITE_URL>/logowanie/google/powrot/ (see README).
# Both empty = no Google buttons.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Payments (Stripe). STRIPE_MODE=sandbox uses test keys (test cards, no
# real money), STRIPE_MODE=live the live ones - switch by changing only this
# line. Keys: Stripe Dashboard -> Developers -> API keys (sandbox: sk_test_...,
# live: sk_live_...; a restricted rk_ key works too). Webhook secret (whsec_...):
# `manage.py stripe_setup --create-webhook` prints it on the server; locally
# `stripe listen --forward-to localhost:8000/stripe/webhook/` shows it.
# After setting the keys run `manage.py stripe_setup` once per mode (README).
STRIPE_MODE=sandbox
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_SANDBOX_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# VAT invoices (inFakt), issued after every successful Stripe payment.
# INFAKT_MODE=sandbox uses api.sandbox-infakt.pl (register a test account at
# https://konto.sandbox-infakt.pl/rejestracja), live uses api.infakt.pl.
# API key: inFakt -> Ustawienia -> Inne opcje -> API, scopes api:invoices:read
# and api:invoices:write. Webhook secret: inFakt -> Integracje -> Webhooki,
# URL <SITE_URL>/infakt/webhook/ (see README). Empty key = no invoices.
INFAKT_MODE=sandbox
INFAKT_SANDBOX_API_KEY=
INFAKT_SANDBOX_WEBHOOK_SECRET=
INFAKT_LIVE_API_KEY=
INFAKT_LIVE_WEBHOOK_SECRET=
# True = send every invoice to KSeF (needs the KSeF integration in inFakt).
INFAKT_SEND_TO_KSEF=False
# Firm name and address by NIP from GUS (REGON, BIR 1.1) - finds every firm,
# also those outside VAT. GUS_MODE=test: GUS's public test key and test data
# (locally); production: a free key requested at
# https://api.stat.gov.pl/Home/RegonApi (arrives by email) in GUS_API_KEY.
GUS_MODE=test
GUS_API_KEY=
# VAT added to the (net) plan prices, in percent. 0 = seller exempt from VAT.
BILLING_VAT_RATE=23
# Google Tag Manager container. Loads only on public pages and only after the
# visitor accepts cookies in the banner. Empty = no analytics at all.
GTM_ID=
# Tools you run inside GTM (comma separated): ga4, google_ads, meta_pixel,
# clarity, linkedin. They fill the cookie banner, the cookie and privacy
# policies and the CSP. A new kind of tool: add it to apps/common/cookies.py.
TRACKING_SERVICES=ga4
# Ownership tokens from Google Search Console / Bing Webmaster Tools
# ("HTML tag" method: paste only the content="..." value). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

