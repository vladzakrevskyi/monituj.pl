# Copy to /srv/monituj/.env on the server and fill in every value.
# Values may contain spaces; do not wrap them in quotes.

# Makes a plain "docker compose ..." in /srv/monituj use the production
# stack, so the development file (with open ports) can't be started by mistake.
COMPOSE_FILE=docker-compose.prod.yml

# --- Django --------------------------------------------------------------
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=monituj.pl,www.monituj.pl
CSRF_TRUSTED_ORIGINS=https://monituj.pl,https://www.monituj.pl
# Used in every email link - must be the public https address.
SITE_URL=https://monituj.pl

# --- Database (container "db") -------------------------------------------
# Letters and digits only: the password becomes part of a URL.
# Generate: openssl rand -hex 24
POSTGRES_DB=monituj
POSTGRES_USER=monituj
POSTGRES_PASSWORD=

# --- Email (SMTP) --------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Monituj <no-reply@monituj.pl>
# Contact form messages go here; replies to system emails land here too.
CONTACT_EMAIL=kontakt@monituj.pl

# --- Operator details for Regulamin / Polityka prywatności / DPA ---------
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_NIP=
LEGAL_REGON=
LEGAL_REGISTER=
LEGAL_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_HOSTING_PROVIDER=
LEGAL_EMAIL_PROVIDER=
LEGAL_HOSTING_LOCATION=
# Effective date of the Terms / Privacy policy / DPA - also their version:
# 2026-10-01 or 01.10.2026. Changing it asks every user to accept the new
# version (from that day) - see README "Zmiana dokumentów prawnych".
LEGAL_EFFECTIVE_DATE=
# How long the hosting keeps its daily server backups (7 copies = 7 days)
LEGAL_BACKUP_DAYS=7

# --- Maintenance mode ------------------------------------------------------
# True shows everyone a "prace techniczne" page (HTTP 503). Addresses listed
# below see the site normally - comma separated, ranges allowed, e.g.
# MAINTENANCE_ALLOWED_IPS=83.12.34.56,2a01:4f8::1,10.0.0.0/24
# Apply a change with: docker compose up -d
MAINTENANCE_MODE=False
MAINTENANCE_ALLOWED_IPS=

# --- Analytics & SEO -------------------------------------------------------
# Master key encrypting uploaded documents on disk (AES-256-GCM). Required
# in production. Generate:
#   python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# KEEP A COPY OUTSIDE THE SERVER (password manager): lose it = lose the files.
DOCUMENTS_ENCRYPTION_KEY=
# Old master keys while rotating (comma separated), see README.
DOCUMENTS_ENCRYPTION_OLD_KEYS=
# Sign in with Google: OAuth client ("Web application") from Google Cloud
# Console, redirect URI <SITE_URL>/logowanie/google/powrot/ (see README).
# Both empty = no Google buttons.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Tag Manager container. Loads only on public pages and only after the
# visitor accepts cookies in the banner. Empty = no analytics at all.
GTM_ID=GTM-NWZ96857
# Tools you run inside GTM (comma separated): ga4, google_ads, meta_pixel,
# clarity, linkedin. They fill the cookie banner, the cookie and privacy
# policies and the CSP. A new kind of tool: add it to apps/common/cookies.py.
TRACKING_SERVICES=ga4
# Ownership tokens from Google Search Console / Bing Webmaster Tools
# ("HTML tag" method: paste only the content="..." value). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
